{
  "name": "piumanager",
  "version": "1.0.",
  "description": "piumanager-workspaces",
  "main": "index.js",
  "repository": "https://github.com/prunusnira/piumanager.git",
  "author": "Nira <prunusnira@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "latest",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-next": "latest",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "turbo": "latest",
    "prettier": "^3.3.3"
  },
  "packageManager": "yarn@1.22.19",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/.prisma/**",
      "**/.prisma",
      "**/@prisma/**",
      "**/@prisma",
      "**/prisma/**",
      "**/prisma"
    ]
  }
}
